{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PDF Manager",
  "version": "0.1.3",
  "identifier": "io.github.pdfmanager.desktop",
  "build": {
    "frontendDist": "../tauri-ui",
    "beforeDevCommand": "npm run build:tauri-ui",
    "beforeBuildCommand": "npm run build:tauri-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Менеджер документов PDF",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Менеджер документов PDF",
    "longDescription": "Десктопная оболочка (Tauri) для менеджера PDF: офлайн HTML-редактор без установки браузерных расширений.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/pdf-manager-icon-v012.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDFManager.PDF",
        "description": "Документ PDF",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Default"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
